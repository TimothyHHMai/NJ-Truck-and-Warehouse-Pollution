<View>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false" brightnessControl="true"/>

  <!-- Warehouse roofs: trace the outline (segmentation, Month 3) -->
  <PolygonLabels name="roof" toName="image" strokeWidth="2" pointSize="small" opacity="0.35">
    <Label value="warehouse_roof" background="#E8A33D" hotkey="w"/>
  </PolygonLabels>

  <!-- Trailers and docks: boxes (YOLO detector, Month 4). Only on 2019 and 2022 chips. -->
  <RectangleLabels name="objects" toName="image" strokeWidth="2" opacity="0.25">
    <Label value="truck_trailer" background="#3D7EE8" hotkey="t"/>
    <Label value="loading_dock" background="#2FB37A" hotkey="d"/>
  </RectangleLabels>

  <!-- Chip-level flags for review -->
  <Choices name="flags" toName="image" choice="multiple" showInline="true">
    <Choice value="uncertain" hint="At least one label is a judgement call; review later"/>
    <Choice value="unusable" hint="Clouds, blur, or missing imagery"/>
  </Choices>
</View>
